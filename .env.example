# --- Required ---
GROQ_API_KEY=
NOTION_TOKEN=
NOTION_HACKATHONS_DB_ID=         # was NOTION_DATABASE_ID in v2
NOTION_PARTICIPATIONS_DB_ID=     # printed by `make setup-notion`
NOTION_PROFILE_PAGE_ID=          # printed by `make setup-notion`

# --- Search: brave (default) or serpapi ---
# SerpApi's free tier is 250 searches/month: with serpapi, also set MAX_QUERIES=8.
SEARCH_PROVIDER=brave
BRAVE_API_KEY=
# SERPAPI_API_KEY=

# --- Optional tuning ---
# GROQ_MODEL=llama-3.3-70b-versatile
# MAX_QUERIES=10
# RESULTS_PER_QUERY=10
# MAX_VERIFY=15
# LLM_CALL_BUDGET=60
# RANK_BUDGET_RESERVE=8
# LLM_CONCURRENCY=2
# REVERIFY_AFTER_DAYS=7
# MLH_SEASON=                    # blank = auto (current season + next)
# LOG_LEVEL=INFO                 # never DEBUG in public Actions (logs can include prompts)
